{
  "manifest_version": 3,
  "name": "YTDM — send to download manager",
  "version": "1.0.0",
  "description": "Adds a Download button on YouTube pages that sends videos and playlists to the YTDM desktop app.",
  "homepage_url": "https://github.com/Shahzaib-Hasaan/ytdm",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:42897/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ytdm@shahzaibbuilds.me",
      "strict_min_version": "115.0"
    }
  }
}
